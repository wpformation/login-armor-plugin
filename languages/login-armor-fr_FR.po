#: admin/class-admin.php:415 admin/views/sections/hide-login.php:95
msgid "Enable Hide Login"
msgstr "Activer Hide Login"

#: admin/class-admin.php:416
msgid ""
"Pick the secret URL for your login page. Visitors will not be able to "
"discover it."
msgstr ""
"Choisissez l’URL secrète de votre page de connexion. Les visiteurs ne "
"pourront pas la découvrir."

#: admin/class-admin.php:417
msgid "Your login slug"
msgstr "Identifiant d’URL de connexion"

#: admin/class-admin.php:418
msgid "Lowercase letters, digits, and hyphens. 3 to 64 characters."
msgstr "Lettres minuscules, chiffres et tirets. 3 à 64 caractères."

